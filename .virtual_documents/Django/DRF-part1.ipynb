from django_filters import rest_framework as filters
from .models import Student

class StudentFilter(filters.FilterSet):
    
    # Optional: Define filters if you want more control/custom behavior
    name = filters.CharFilter(lookup_expr='icontains')  # Case-insensitive contains
    
    min_score = filters.NumberFilter(field_name='score', lookup_expr='gte')  # score >= min_score
    max_score = filters.NumberFilter(field_name='score', lookup_expr='lte')  # score <= max_score
    
    min_age = filters.NumberFilter(field_name='age', lookup_expr='gte')  # age >= min_age
    max_age = filters.NumberFilter(field_name='age', lookup_expr='lte')  # age <= max_age
    
    city = filters.CharFilter(lookup_expr='iexact')  # Case-insensitive exact match
      
    class Meta:
        model = Student
        fields = ['name', 'age', 'city'] # Only include actual model field names here
        # fields are allowed to be filtered in the API request.
        # all fields specified here will support exact match
        





