# serializers.py:

from rest_framework import serializers
from .models import Student

class StudentSerializer(serializers.ModelSerializer):
    class Meta:
        model = Student
        fields = '__all__'

    def validate(self, data): # validating all fields
        """
        Perform object-level validation.
        This method is called after field-level validations.
        """
        name = data.get('name')
        city = data.get('city')
        age = data.get('age')

        # Example: name and city should not be the same
        if name and city and name.lower() == city.lower():
            raise serializers.ValidationError("Name and city cannot be the same.")

        # Example: age should be within a reasonable range
        if age is not None and (age <= 0 or age > 120):
            raise serializers.ValidationError({"age": "Age must be between 1 and 120."})

        return data



