# api/views.py

from rest_framework.mixins import (
    ListModelMixin, CreateModelMixin, RetrieveModelMixin,
    UpdateModelMixin, DestroyModelMixin
)
from rest_framework.generics import GenericAPIView
from .models import Student
from .serializers import StudentSerializer


# Handles: GET (list) and POST (create) for /students/
class LCStudentAPI(GenericAPIView, ListModelMixin, CreateModelMixin):
    queryset = Student.objects.all()
    serializer_class = StudentSerializer
    lookup_field = 'pk'  # Not strictly needed here, but fine to include

    # GET /students/ → List all students
    def get(self, request, *args, **kwargs):
        return self.list(request, *args, **kwargs)

    # POST /students/ → Create a new student
    def post(self, request, *args, **kwargs):
        return self.create(request, *args, **kwargs)


# Handles: GET (retrieve), PUT (update), PATCH (partial update), DELETE
# for /students/<pk>/
class RUDStudentAPI(GenericAPIView, RetrieveModelMixin, UpdateModelMixin, DestroyModelMixin):
    queryset = Student.objects.all()
    serializer_class = StudentSerializer
    lookup_field = 'pk'  # default is 'pk'

    # GET /students/<pk>/ → Retrieve a specific student
    def get(self, request, *args, **kwargs):
        return self.retrieve(request, *args, **kwargs)

    # PUT /students/<pk>/ → Full update of a student
    def put(self, request, *args, **kwargs):
        return self.update(request, *args, **kwargs)

    # PATCH /students/<pk>/ → Partial update of a student
    def patch(self, request, *args, **kwargs):
        return self.partial_update(request, *args, **kwargs)

    # DELETE /students/<pk>/ → Delete a student
    def delete(self, request, *args, **kwargs):
        return self.destroy(request, *args, **kwargs)









