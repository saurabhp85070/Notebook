# api/views.py:

from rest_framework.viewsets import ViewSet
from rest_framework.response import Response
from rest_framework.permissions import IsAuthenticated, IsAdminUser
from rest_framework.authentication import BasicAuthentication
from rest_framework import status
from django.shortcuts import get_object_or_404
from .models import Student
from .serializers import StudentSerializer

class StudentViewSet(ViewSet):
    # Use Basic Authentication for this ViewSet
    authentication_classes = [BasicAuthentication]

    # Dynamically assign permissions based on the action being performed
    def get_permissions(self):                                    # can used in all views
        # Only admin users can delete (destroy) a student
        if self.action == 'destroy':
            return [IsAdminUser()] # Only admin can delete
            
        # For all other actions (list, retrieve), just check if user is authenticated
        return [IsAuthenticated()] # Others must just be logged in

    # GET /students/ → List all students
    def list(self, request):
        students = Student.objects.all()
        serializer = StudentSerializer(students, many=True)
        return Response(serializer.data)

    # GET /students/<pk>/ → Retrieve a single student by ID
    def retrieve(self, request, pk=None):
        student = get_object_or_404(Student, pk=pk)
        serializer = StudentSerializer(student)
        return Response(serializer.data)

    # DELETE /students/<pk>/ → Delete a student (admin only)
    def destroy(self, request, pk=None):
        student = get_object_or_404(Student, pk=pk)
        student.delete()
        return Response(
            {'message': 'Student deleted successfully'},
            status=status.HTTP_204_NO_CONTENT
        )






from rest_framework.permissions import AllowAny, IsAuthenticated, IsAdminUser
from rest_framework.viewsets import ModelViewSet

class MyModelViewSet(ModelViewSet):
    queryset = MyModel.objects.all()
    serializer_class = MyModelSerializer

    def get_permissions(self):
        if self.action in ['list', 'retrieve']:
            return [AllowAny()]  # Anyone can view
        elif self.action in ['create', 'update', 'partial_update']:
            return [IsAuthenticated()]  # Only logged-in users can create/update
        elif self.action == 'destroy':
            return [IsAdminUser()]  # Only admins can delete
        return super().get_permissions()






# permissions.py (custom permission)

from rest_framework.permissions import BasePermission

class IsAdminForDelete(BasePermission):
    """
    Allow only admins (is_staff) to delete, allow others for other methods.
    """

    def has_permission(self, request, view):
        if request.method == 'DELETE':
            return request.user and request.user.is_authenticated and request.user.is_staff
        return request.user and request.user.is_authenticated



