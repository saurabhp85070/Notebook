from rest_framework.throttling import BaseThrottle
from django.core.cache import cache
import time

class CustomThrottle(BaseThrottle):
    """
    Custom throttle: allows only 3 requests per minute per IP.
    Stores data in Django's cache system.
    """
    THROTTLE_LIMIT = 3         # Max 3 requests
    THROTTLE_TIME = 60         # Time window in seconds (1 minute)

    def allow_request(self, request, view):
        user_ip = self.get_ident(request)
        cache_key = f"throttle:{user_ip}"
        current_time = time.time()

        request_times = cache.get(cache_key, [])

        # Remove timestamps older than the time window
        request_times = [t for t in request_times if t > current_time - self.THROTTLE_TIME]

        if len(request_times) >= self.THROTTLE_LIMIT:
            return False  # Throttle request

        # Log this request
        request_times.append(current_time)
        cache.set(cache_key, request_times, timeout=self.THROTTLE_TIME)
        return True

    def wait(self):
        """
        Optionally returns the remaining time before the user can make the next request.
        (Only used if DRF wants to include `Retry-After` header.)
        """
        return self.THROTTLE_TIME






