from rest_framework.response import Response
from .models import Student
from .serializers import StudentSerializer
from rest_framework import status
from rest_framework.views import APIView
from django.shortcuts import get_object_or_404


class StudentAPI(APIView):
    def get (self, request, pk=None, format=None) :
        id = pk
        if id is not None:
            stu = get_object_or_404(Student, pk=id) # Student.objects.get(pk=id)
            serializer = StudentSerializer(stu)
            return Response(serializer.data)
        stu = Student. objects.all()
        serializer = StudentSerializer(stu, many=True)
        return Response(serializer.data)
        
    def post(self, request, format=None):
        serializer = StudentSerializer (data=request.data)
        if serializer.is_valid():
            serializer.save()
            return Response({'msg': 'Data Created'}, status = status.HTTP_201_CREATED) 
        return Response(serializer.errors, status = status.HTTP_400_BAD_REQUEST)

    def put(self, request, pk=None, format=None):
        id = pk
        stu = get_object_or_404(Student, pk=id)
        serializer = StudentSerializer(stu, data=request.data)
        if serializer.is_valid():
            serializer.save()
            return Response({'msg': 'Complete Data updated'}) # we can set status also
        return Response(serializer.errors)

    def patch(self, request, pk=None, format=None):
        id = pk
        stu = get_object_or_404(Student, pk=id)
        serializer = StudentSerializer(stu, data=request.data, partial=True)
        if serializer.is_valid():
            serializer.save()
            return Response({'msg': 'Partial Data updated'}) # we can set status also
        return Response(serializer.errors)

    def delete(self, request, pk=None, format=None):
        id = pk
        stu = get_object_or_404(Student, pk=id)
        stu.delete()
        return Response({'msg': 'Data Deleted' }) # we can set status also


