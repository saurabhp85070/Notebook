# views.py

from rest_framework.generics import GenericAPIView
from rest_framework.response import Response
from rest_framework import status
from django.shortcuts import get_object_or_404

from .models import Blog
from .serializers import BlogSerializer


# -----------------------------
# View for: GET (all blogs) and POST (create a blog)
# URL: /blogs/
# -----------------------------
class BlogListCreateView(GenericAPIView):
    queryset = Blog.objects.all()                 # Define the queryset
    serializer_class = BlogSerializer             # Define the serializer

    # GET /blogs/ - List all blog posts
    def get(self, request, *args, **kwargs):
        blogs = self.get_queryset()               # Get all blog objects
        serializer = self.get_serializer(blogs, many=True)  # Serialize multiple objects
        return Response(serializer.data)          # Return serialized data

    # POST /blogs/ - Create a new blog post
    def post(self, request, *args, **kwargs):
        serializer = self.get_serializer(data=request.data)  # Deserialize request data
        if serializer.is_valid():                  # Validate data
            serializer.save()                      # Save to DB if valid
            return Response(serializer.data, status=status.HTTP_201_CREATED)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)


# -----------------------------
# View for: GET, PUT, PATCH, DELETE (single blog post)
# URL: /blogs/<pk>/
# -----------------------------
class BlogDetailView(GenericAPIView):
    queryset = Blog.objects.all()                 # Define the queryset
    serializer_class = BlogSerializer             # Define the serializer

    # Helper method to retrieve blog by primary key (pk)
    def get_object(self):
        return get_object_or_404(Blog, pk=self.kwargs.get('pk')) # recommended approach

    # def get_object(self, pk):
    #     return get_object_or_404(Blog, pk=pk)

    # GET /blogs/<pk>/ - Retrieve a single blog post
    def get(self, request, pk, *args, **kwargs):
        blog = self.get_object()                   # Get blog by ID or return 404
        serializer = self.get_serializer(blog)     # Serialize the blog object
        return Response(serializer.data)

    # PUT /blogs/<pk>/ - Full update (replace all fields)
    def put(self, request, pk, *args, **kwargs):
        blog = self.get_object()
        serializer = self.get_serializer(blog, data=request.data)  # Full data required
        if serializer.is_valid():
            serializer.save()                      # Update blog in DB
            return Response(serializer.data)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

    # PATCH /blogs/<pk>/ - Partial update (only specified fields)
    def patch(self, request, pk, *args, **kwargs):
        blog = self.get_object()
        serializer = self.get_serializer(blog, data=request.data, partial=True)  # Allow partial update
        if serializer.is_valid():
            serializer.save()
            return Response(serializer.data)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

    # DELETE /blogs/<pk>/ - Delete a blog post
    def delete(self, request, pk, *args, **kwargs):
        blog = self.get_object()
        blog.delete()                              # Remove blog from DB
        return Response(status=status.HTTP_204_NO_CONTENT)









from rest_framework.generics import GenericAPIView
from rest_framework.response import Response
from rest_framework import status
from django.shortcuts import get_object_or_404

from .models import Blog
from .serializers import BlogSerializer


class BlogDetailView(GenericAPIView):
    queryset = Blog.objects.all()
    serializer_class = BlogSerializer

    def get_object(self):
        return get_object_or_404(Blog, pk=self.kwargs.get('pk'))

    def get(self, request, pk, *args, **kwargs):
        return self._handle_request(request, pk, method="get")

    def put(self, request, pk, *args, **kwargs):
        return self._handle_request(request, pk, method="put")

    def patch(self, request, pk, *args, **kwargs):
        return self._handle_request(request, pk, method="patch")

    def delete(self, request, pk, *args, **kwargs):
        return self._handle_request(request, pk, method="delete")

    def _handle_request(self, request, pk, method):
        blog = self.get_object()

        if method == "get":
            serializer = self.get_serializer(blog)
            return Response(serializer.data)

        elif method in ("put", "patch"):
            partial = method == "patch"
            serializer = self.get_serializer(blog, data=request.data, partial=partial)
            if serializer.is_valid():
                serializer.save()
                return Response(serializer.data)
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        elif method == "delete":
            blog.delete()
            return Response(status=status.HTTP_204_NO_CONTENT)












