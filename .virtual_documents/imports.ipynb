# views.py:

class ViewClass(CBV):
    queryset = Student.objects.all()
    serializer_class = StudentSerializer

    # filtering
    filter_backends = [DjangoFilterBackend]
    filterset_fields = ['name', 'city'] # Fields to filter by
    filterset_fields = {
        'name': ['exact', 'contains'],
        'city': ['iexact', 'icontains'],
    }
    filterset_class = StudentFilter # custom filter

    # searching
    filter_backends = [SearchFilter] # locally or per view
    search_fields = ['name', 'city']

    # ordering
    filter_backends = [OrderingFilter]  # 👈 enable ordering
    ordering_fields = ['name', 'age', 'city']  # 👈 allowed fields for ordering
    ordering = ['name']  # 👈 default ordering (optional)

    # pagination
     pagination_class = PageNumberPagination
